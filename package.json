{
	"name": "howlcast",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^6",
			"@cloudflare/workers-types": "^4.20260502.1",
			"hono": "^4.8.2",
			"@trpc/server": "^11.16.0",
			"better-auth": "^1.6.9",
			"alchemy": "^0.93.6",
			"wrangler": "^4.77.0",
			"lucide-react": "^1.14.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.3",
			"react-dom": "^19.2.3",
			"sonner": "^2.0.5",
			"@libsql/client": "^0.17.3",
			"libsql": "^0.5.29",
			"@trpc/client": "^11.16.0",
			"@types/react": "^19.2.10",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.1.18",
			"resend": "^6.12.2",
			"nodemailer": "^8.0.7",
			"@types/nodemailer": "^8.0.0"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev",
		"db:push": "turbo -F @howlcast/db db:push",
		"db:generate": "turbo -F @howlcast/db db:generate",
		"deploy": "turbo -F @howlcast/infra deploy",
		"destroy": "turbo -F @howlcast/infra destroy",
		"dev:mail": "docker compose -f docker-compose.dev.yml up -d mailpit",
		"dev:mail:stop": "docker compose -f docker-compose.dev.yml down",
		"dev:mail:logs": "docker compose -f docker-compose.dev.yml logs -f mailpit",
		"check": "biome check --write .",
		"prepare": "husky"
	},
	"dependencies": {
		"@howlcast/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@cloudflare/workers-types": "catalog:",
		"@howlcast/config": "workspace:*",
		"@types/node": "^24",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.2",
		"turbo": "^2.8.12",
		"typescript": "catalog:"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write ."
		]
	},
	"packageManager": "bun@1.3.13"
}
